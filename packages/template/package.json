{
  "name": "@site-factory/template",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Config-driven Astro/Tailwind site template; deploys to Cloudflare Pages.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/check-injection.mjs && astro build && node scripts/gen-headers.mjs && node scripts/check-headers.mjs && node ../../scripts/verify-built.mjs",
    "preview": "astro preview",
    "typecheck": "astro check"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/react": "^7.0.1",
    "@astrojs/sitemap": "^3.7.4",
    "@site-factory/copy": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.8",
    "oxc-transform-react": "^0.145.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "playwright": "^1.49.1",
    "typescript": "^5.7.3"
  }
}
